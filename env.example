# Copy this file to .env and replace the placeholder values with your Vantage Markets MT5 credentials.
# Never commit real credentials to the repository.
#
# Typical Vantage MT5 server names are like:
#   VantageMarkets-Demo
#   VantageMarkets-Live
# Replace these with the exact names shown in your MT5 login window.

MT5_DEMO_LOGIN=1234567
MT5_DEMO_PASSWORD=REPLACE_WITH_YOUR_DEMO_PASSWORD
MT5_DEMO_SERVER=VantageMarkets-Demo

MT5_LIVE_LOGIN=1234567
MT5_LIVE_PASSWORD=REPLACE_WITH_YOUR_LIVE_PASSWORD
MT5_LIVE_SERVER=VantageMarkets-Live

# Optional project-level settings
MT5_TIMEOUT_MS=10000
MT5_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
MT5_ACCOUNT_SUFFIX=985
MT5_REQUIRED_SERVER=VantageMarkets-Demo
MT5_ALLOW_LIVE=false
